# ============================================================
# VARIABLES DE ENTORNO — KINGSLEY CAPS BACKEND
# Para desarrollo local: copia esto a server/.env y rellena los valores
# Para produccion (Render): ingresa cada variable en el dashboard
# ============================================================

# Entorno
NODE_ENV=production
PORT=10000

# Base de datos Supabase
# Obtén en: Supabase Dashboard > Project Settings > Database > Connection string > Transaction Pooler
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# CORS — URL exacta de tu servicio en Render
FRONTEND_URL=https://kingsley-caps.onrender.com

# JWT — genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_ALEATORIA_LARGA_64_CHARS
JWT_REFRESH_SECRET=CAMBIA_ESTO_POR_OTRA_CADENA_ALEATORIA_DISTINTA_64_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Blockchain Ethereum (red de pruebas Sepolia)
ETH_NETWORK=sepolia
ETH_RPC_URL=https://rpc.sepolia.org
ETH_CONFIRMATIONS_REQUIRED=3
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# IA — Google Gemini (gratis en https://aistudio.google.com/apikey)
GOOGLE_GEMINI_API_KEY=AIza...

# IA — HuggingFace (opcional)
HUGGINGFACE_API_TOKEN=hf_...

# Logs
LOG_LEVEL=info
